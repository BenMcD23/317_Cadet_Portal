AUTH_SECRET=your_nextauth_secret_here

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# The SMS API's origin. Locally that's uvicorn; deployed it's the Lambda
# Function URL (https://<id>.lambda-url.<region>.on.aws — a trailing slash is
# fine, lib/api-base.ts strips it). Only ever read server-side, in the route
# handlers under app/api/, so the browser never talks to the API cross-origin.
NEXT_PUBLIC_API_BASE=http://localhost:8000
